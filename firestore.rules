rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public can browse the tent catalog; only an authenticated admin edits it.
    match /tents/{tentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public can request a booking but never read the list (phone numbers,
    // other clients' bookings/addresses). Must always come in as 'pending' —
    // only an authenticated admin can confirm/cancel/complete or read back.
    match /bookings/{bookingId} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }

    // Public can submit a review but it must start unapproved; only
    // approved reviews are publicly visible. Moderation is admin-only.
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || request.auth != null;
      allow create: if request.resource.data.approved == false;
      allow update, delete: if request.auth != null;
    }
  }
}
